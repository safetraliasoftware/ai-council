{
  "name": "@ai-council/desktop",
  "version": "0.1.0",
  "description": "Desktop-App zum gemeinsamen Beauftragen von Claude, Gemini und ChatGPT",
  "main": "./out/main/index.js",
  "author": "Andre",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
